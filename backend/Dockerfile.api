# Imagen de producción de la API (Railway): solo FastAPI y psycopg, sin el ETL ni sus dependencias
# geoespaciales. Se construye con backend/ como contexto (Root Directory /backend en Railway), igual
# que el frontend. Para desarrollo con docker-compose se usa backend/Dockerfile.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-api.txt /app/backend/requirements-api.txt
RUN pip install -r /app/backend/requirements-api.txt

# El paquete se llama backend (uvicorn backend.main:app): el contexto se copia en /app/backend.
COPY . /app/backend/
RUN test -f /app/backend/api/routes.py \
    || (echo "Falta api/ en el contexto de build:" && find /app/backend -maxdepth 2 && exit 1)

EXPOSE 8000

# Railway inyecta PORT; --proxy-headers porque la API queda detrás del Caddy del frontend.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
