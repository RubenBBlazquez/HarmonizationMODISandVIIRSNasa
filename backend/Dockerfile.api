# Imagen de producción de la API (Railway): solo FastAPI y psycopg, sin el ETL ni sus dependencias
# geoespaciales. Para desarrollo con docker-compose se usa backend/Dockerfile.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements-api.txt /app/backend/requirements-api.txt
RUN pip install -r /app/backend/requirements-api.txt

# Se copia backend/ entero (el .dockerignore deja fuera datos, salidas y entornos) y se comprueba
# que llegó la API: si falta, el log del build muestra qué ficheros contiene el contexto.
COPY backend/ /app/backend/
RUN test -f /app/backend/api/routes.py \
    || (echo "Falta backend/api en el contexto de build:" && find /app/backend -maxdepth 2 \
        && exit 1)

EXPOSE 8000

# Railway inyecta PORT; --proxy-headers porque la API queda detrás del Caddy del frontend.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
